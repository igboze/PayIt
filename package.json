{
  "name": "payit-telegram-bot",
  "version": "0.3.0",
  "description": "PayIT — non-custodial Telegram wallet on Arc (testnet). Personal + Business accounts, USDC + EURC, Circle Gateway, SME financial management.",
  "main": "bot.js",
  "type": "commonjs",
  "scripts": {
    "start": "node bot.js",
    "generate-wallet": "node generate-wallet.js",
    "compile-contracts": "node scripts/compile-contracts.js",
    "deploy:invoice-settlement": "dotenv -e .env -- node scripts/deploy-invoice-settlement.js",
    "fund-paymaster": "dotenv -e .env -- node scripts/fund-paymaster.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:contracts": "node --test tests/contract_invoice_settlement.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@circle-fin/adapter-ethers-v6": "^1.12.0",
    "@circle-fin/earn-kit": "^1.7.0",
    "@circle-fin/swap-kit": "^1.7.0",
    "@google/generative-ai": "^0.24.1",
    "@resvg/resvg-js": "^2.6.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "axios": "^1.7.7",
    "bs58": "^6.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^16.6.1",
    "ed25519-hd-key": "^2.0.0",
    "ethers": "^6.17.0",
    "exceljs": "^4.4.0",
    "groq-sdk": "^1.3.0",
    "jszip": "^3.10.1",
    "node-cron": "^4.5.0",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "telegraf": "^4.16.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "sharp@0.33.5": true,
    "@resvg/resvg-js@2.6.2": true
  },
  "devDependencies": {
    "dotenv-cli": "^7.1.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.20"
  }
}
