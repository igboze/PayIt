{
  "expo": {
    "name": "Proxim",
    "slug": "proxim-mobile",
    "version": "1.0.7",
    "runtimeVersion": "1",
    "updates": {
      "enabled": true,
      "url": "https://payit-production.up.railway.app/api/app/v1/ota/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "orientation": "portrait",
    "scheme": "proxim",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1117",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.proxim.mobile",
      "associatedDomains": [
        "applinks:payit-production.up.railway.app",
        "webcredentials:payit-production.up.railway.app"
      ]
    },
    "android": {
      "package": "app.proxim.mobile",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07271A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "payit-production.up.railway.app",
              "pathPrefix": "/link/"
            },
            {
              "scheme": "https",
              "host": "payit-production.up.railway.app",
              "pathPrefix": "/pay/"
            },
            {
              "scheme": "https",
              "host": "payit-production.up.railway.app",
              "pathPrefix": "/checkout/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-updates",
      "./plugins/withReleaseSigning",
      "expo-font",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Proxim to access your photos to upload your profile picture or verification documents.",
          "cameraPermission": "Allow Proxim to use your camera to take a profile photo or verification document photo.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://payit-production.up.railway.app/api/app/v1"
    }
  }
}